{
  "buildCommand": "npm run frontend:build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api-docs(.*)", "destination": "/api" },
    { "source": "/assets/(.*)", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
